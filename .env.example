# Runtime env for the Next.js container. Placeholders only; real values go in
# the backend repo's deploy/.env.prod (never commit it).

# FastAPI base URL, server-side only (BFF route handlers call it). In the
# docker-compose stack this is the internal service name, never public.
API_URL="http://app:8000/api/v1"

# Parent phone-OTP login: tenant UUID to look phone numbers up in. Empty = backend default tenant.
OTP_TENANT_ID=""

# Google sign-in web client ID. NEXT_PUBLIC_* is inlined at BUILD time:
# pass as docker build arg, changing it at runtime has no effect. Empty hides the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# TEMPORARY, plain-HTTP-on-IP phase only: allows session cookies without the
# Secure flag (browsers discard Secure cookies over http://, so login fails).
# MUST be removed/false once HTTPS is enabled. Anything but "true" = Secure in production.
ALLOW_INSECURE_COOKIES="false"
