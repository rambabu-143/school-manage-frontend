# Base URL of the FastAPI backend. Server-side only (Route Handlers proxy to
# this) - never exposed to the browser, so no NEXT_PUBLIC_ prefix.
API_URL="http://localhost:8000/api/v1"

# Parent phone-OTP login: tenant to look the phone number up in. Server-side only.
# Leave empty to use the backend's default tenant.
OTP_TENANT_ID=""

# Google sign-in: OAuth web client ID (public identifier, not a secret). Must be
# one of the backend's GOOGLE_CLIENT_IDS. Leave empty to hide the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
